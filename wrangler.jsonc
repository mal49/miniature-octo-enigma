// Static site: `wrangler deploy` uploads the Next.js export in out/. No server code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miniature-octo-enigma",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
